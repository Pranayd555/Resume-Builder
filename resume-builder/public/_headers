# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/

# Keep the production *.pages.dev copy of the site out of search results;
# presmistique.in is the only canonical host. (Preview deployments already
# get X-Robots-Tag: noindex from Pages.)
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Sign-in pages: reachable, but not search results.
/login
  X-Robots-Tag: noindex
/register
  X-Robots-Tag: noindex
/admin-login
  X-Robots-Tag: noindex
/auth/*
  X-Robots-Tag: noindex

# Built JS/CSS file names contain a content hash, so they can be cached for a year.
/static/*
  Cache-Control: public, max-age=31536000, immutable
