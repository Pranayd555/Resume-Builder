# =============================================================================
# FRONTEND ENVIRONMENT TEMPLATE - Resume Builder React App
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control!

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL - Update for each environment
REACT_APP_API_URL=http://localhost:5000/api

# =============================================================================
# RAZORPAY CONFIGURATION
# =============================================================================
# Nothing to set here: the checkout key comes from the API
# (GET /api/payment/config). Razorpay keys live in backend/.env. See docs/PAYMENTS.md.

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application name and branding
REACT_APP_NAME=Resume Builder
REACT_APP_VERSION=1.0.0

# =============================================================================
# ENVIRONMENT EXAMPLES
# =============================================================================

# DEVELOPMENT ENVIRONMENT:
# REACT_APP_API_URL=http://localhost:5000/api

# STAGING ENVIRONMENT:
# REACT_APP_API_URL=https://your-staging-backend.herokuapp.com/api

# PRODUCTION ENVIRONMENT:
# REACT_APP_API_URL=https://your-production-backend.herokuapp.com/api
